# Environment Variables — VELoop Rewards Backend
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: Atlas > Database > Connect > Drivers
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use a minimum 64-character random string in production.
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=1d

# ─── CAPTCHA ─────────────────────────────────────────────────────────────────
# Seconds before a CAPTCHA challenge expires (default: 120 = 2 minutes)
CAPTCHA_EXPIRY_SECONDS=120

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Development: http://localhost:5173 (Vite) or http://localhost:3000 (CRA)
# Production:  set to your deployed frontend URL (no trailing slash)
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# All limits are per-IP per window. Tune as needed for your environment.
RATE_LIMIT_WINDOW_MS=900000          # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100          # Global limit on all /api/* routes

# Per-endpoint limits (requests per window per IP)
CAPTCHA_CURRENT_LIMIT_MAX=60         # GET /api/captcha/current
CAPTCHA_VERIFY_LIMIT_MAX=30          # POST /api/captcha/verify
CAPTCHA_CLAIM_LIMIT_MAX=30           # POST /api/captcha/claim
CAPTCHA_NEW_LIMIT_MAX=30             # POST /api/captcha/new
