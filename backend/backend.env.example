# ─── backend.env.example — Backend secrets template ──────────────────────────
# Copy this file to backend/backend.env and fill in real values.
# backend.env is gitignored and MUST NEVER be committed.
# Both backend instances use the same file — same DB, same JWT secret.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas — must be the same connection string for both instances
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# JWT — must be identical across both instances so tokens are cross-instance valid
JWT_SECRET=replace_with_64_plus_random_characters
JWT_EXPIRES_IN=1d

# CAPTCHA
CAPTCHA_EXPIRY_SECONDS=120

# Node environment
NODE_ENV=production

# CORS — set to the Nginx load-balancer URL (or your Vercel frontend URL in production)
FRONTEND_URL=http://localhost:8080

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CAPTCHA_CURRENT_LIMIT_MAX=60
CAPTCHA_VERIFY_LIMIT_MAX=30
CAPTCHA_CLAIM_LIMIT_MAX=30
CAPTCHA_NEW_LIMIT_MAX=30
