# ─── Nginx Load Balancer — Environment ────────────────────────────────────────
# Copy to load-balancer/.env and fill in the values.
# NEVER commit real values.

# Hostnames/ports of the two backend instances
# Local example:
BACKEND_1_HOST=backend-1
BACKEND_1_PORT=5001

BACKEND_2_HOST=backend-2
BACKEND_2_PORT=5002

# Nginx listen port (the public-facing port)
NGINX_PORT=8080
