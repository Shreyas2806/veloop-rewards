# Root .gitignore — VELoop Rewards

# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local

# Docker Compose runtime secrets — NEVER commit these
backend/backend.env

# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
